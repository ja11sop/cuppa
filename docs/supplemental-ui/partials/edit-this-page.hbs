{{!--
  Toolbar trailing control: article width toggle.

  Replaces the bundle "Edit this Page" link (already suppressed). The
  .edit-this-page wrapper keeps the bundle's ≥1024px visibility rule and sits
  at the right end of the toolbar after breadcrumbs.
--}}
<div class="edit-this-page cuppa-doc-width">
  <button
    type="button"
    class="cuppa-doc-width-toggle"
    aria-pressed="false"
    title="Widen article"
    aria-label="Widen article"
  >
    <span class="cuppa-doc-width-toggle__icon" aria-hidden="true"></span>
  </button>
</div>
