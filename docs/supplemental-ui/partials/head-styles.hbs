<link rel="stylesheet" href="{{{uiRootPath}}}/css/site.css">
{{!--
  All palettes are linked; only one is enabled. Cold-start default is cup-of-tea.
  Runtime cycling (toolbar) and localStorage restore enable/disable these links.
  Each file carries light and prefers-color-scheme: dark tokens.
--}}
<link rel="stylesheet" href="{{{uiRootPath}}}/css/cuppa-palette-cup-of-tea.css" data-cuppa-palette="cup-of-tea">
<link rel="stylesheet" href="{{{uiRootPath}}}/css/cuppa-palette-harbour.css" data-cuppa-palette="harbour" disabled>
<link rel="stylesheet" href="{{{uiRootPath}}}/css/cuppa-palette-forest.css" data-cuppa-palette="forest" disabled>
<link rel="stylesheet" href="{{{uiRootPath}}}/css/cuppa-palette-aubergine.css" data-cuppa-palette="aubergine" disabled>
<link rel="stylesheet" href="{{{uiRootPath}}}/css/cuppa.css">
{{!-- Apply stored width and palette before paint to avoid a flash. --}}
<script>
(function () {
  try {
    var mode = localStorage.getItem('cuppa-doc-width');
    if (mode === 'wide') {
      document.documentElement.classList.add('cuppa-doc-wide');
    } else if (mode === 'full') {
      document.documentElement.classList.add('cuppa-doc-full');
    }
  } catch (e) {}
  try {
    var order = [
      'cup-of-tea',
      'harbour',
      'forest',
      'aubergine',
    ];
    var id = localStorage.getItem('cuppa-doc-palette');
    if (id === 'mint-tea' || id === 'fine-bone-china') {
      id = 'cup-of-tea';
    }
    if (order.indexOf(id) < 0) {
      id = 'cup-of-tea';
    }
    var links = document.querySelectorAll('link[data-cuppa-palette]');
    for (var i = 0; i < links.length; i++) {
      links[i].disabled = links[i].getAttribute('data-cuppa-palette') !== id;
    }
  } catch (e) {}
})();
</script>
